# Copy to jenkins/.env (git-ignored) and change every value. Fake examples only.
# Jenkins administrator (user "admin").
JENKINS_ADMIN_PASSWORD=change_me_admin
# Stored by Jenkins as the credential "taskmanager-db-credentials"
# (the pipeline passes it to docker compose as POSTGRES_USER / POSTGRES_PASSWORD).
TM_DB_USER=tasks_user
TM_DB_PASSWORD=change_me_db
